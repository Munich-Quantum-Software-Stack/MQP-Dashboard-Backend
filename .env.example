# Example environment variables for local development/testing.
# Copy this file to .env and replace values with real secrets locally.
# Do NOT commit real .env files.

# Application
QUANTUM_DB_PEPPER=test-pepper
QUANTUM_DB_TOKEN_PEPPER=test-token-pepper

# Testing
QUANTUM_DB_TESTING=TRUE
QUANTUM_DB_FILENAME=test_db.sqlite
QUANTUM_DB_USER=postgres
QUANTUM_DB_PASS=example
QUANTUM_DB_HOST=localhost
JWT_SECRET_KEY=test-jwt-secret

# LDAP
QUANTUM_DS_HOST=
LDAP_USER_DN=

# Quantum Host
PIP_TRUSTED_HOST=
# Dockerhub
DOCKERHUB=

# Quantum Database
QUANTUM_DB_USER=
QUANTUM_DB_PASS=
PGUSER=
QUANTUM_DB_HOST=

# MQP Mail Configuration
MQP_MAIL_SERVER=
MQP_MAIL_PORT=
MQP_MAIL_USE_TLS=
MQP_MAIL_USE_SSL=
MQP_MAIL_USERNAME=
MQP_MAIL_PWD=
MQP_MAIL_DEFAULT_SENDER=
MQP_MAIL_ADMIN=
MQP_MAIL_RECIPIENTS=

# Pypi
PIP_EXTRA_INDEX_URL=https://pypi.quantum.lrz.de

# Proxy Database
PROXY_DB_HOST=
PROXY_DB_PORT=
PROXY_DB=
PROXY_DB_USER=
PROXY_DB_PASS=

# Example environment variables for local development/testing.
# Copy this file to .env and replace values with real secrets locally.
# Do NOT commit real .env files.

ENV=

# Application Environment Variables
JWT_SECRET_KEY=
CERT_FILE=
KEY_FILE=

# LDAP
QUANTUM_DS_HOST=
LDAP_USER_DN=

# Quantum Host
PIP_TRUSTED_HOST=
# Dockerhub
DOCKERHUB=

# Quantum Database
QUANTUM_DB_USER=
QUANTUM_DB_PASS=
PGUSER=
QUANTUM_DB_HOST=

# MQP Mail Configuration
MQP_MAIL_SERVER=
MQP_MAIL_PORT=
MQP_MAIL_USE_TLS=
MQP_MAIL_USE_SSL=
MQP_MAIL_USERNAME=
MQP_MAIL_PWD=
MQP_MAIL_DEFAULT_SENDER=
MQP_MAIL_ADMIN=
MQP_MAIL_RECIPIENTS=

# Pypi
PIP_EXTRA_INDEX_URL=

# Proxy Database
PROXY_DB_HOST=
PROXY_DB_PORT=
PROXY_DB=
PROXY_DB_USER=
PROXY_DB_PASS=

# The following variables are used only for testing environment. These can be exported by command:
# source .env
# or export each variable in shell window
export QUANTUM_DB_PEPPER=test-pepper
export QUANTUM_DB_TOKEN_PEPPER=test-token-pepper
export QUANTUM_DB_TESTING=TRUE
export QUANTUM_DB_FILENAME=test_db.sqlite
export QUANTUM_DB_USER=postgres
export QUANTUM_DB_PASS=example
export QUANTUM_DB_HOST=localhost
export JWT_SECRET_KEY=test-jwt-secret
# LDAP
export QUANTUM_DS_HOST="ldap://localhost:8888"
export LDAP_USER_DN="ou=QuantumComputing,ou=Kennungen,o=example-org,c=de"
